{
  "rules": {
    "catalog": {
      ".read": true,
      ".write": "auth != null || !data.exists()",
      "$itemId": {
        "views": {
          ".write": true
        }
      }
    },
    "orders": {
      ".read": true,
      "$orderId": {
        ".write": "auth != null || !data.exists() || newData.child('status').val() == data.child('status').val()"
      }
    },
    "lastAdminLogin": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
